generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role         @default(STUDENT)
  bio            String?
  hasPaid            Boolean      @default(false)
  stripeCustomerId   String?      @unique
  stripeSubId        String?
  paidAt             DateTime?
  subscriptionStatus String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts    Account[]
  sessions    Session[]
  enrollments Enrollment[]
  progress    Progress[]

  // Gamification
  stats            UserStats?
  achievements     UserAchievement[]
  xpEvents         XpEvent[]

  // Features
  tutorChats       TutorChat[]
  projects         Project[]
  peerReviews      PeerReview[]
  lessonNotes      LessonNote[]

  // Cohorts
  ownedCohorts     Cohort[]          @relation("CohortOwner")
  cohortMembers    CohortMember[]
  projectComments  ProjectComment[]  @relation("ProjectComments")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Course {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  thumbnail       String?
  lectureVideoUrl String?
  published       Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  recordings   Recording[]
  cohortCourses CohortCourse[]

  @@map("courses")
}

model Module {
  id       String @id @default(cuid())
  title    String
  order    Int    @default(0)
  courseId String

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id        String  @id @default(cuid())
  title     String
  slug      String
  content   String  @db.Text
  videoUrl  String?
  githubUrl String?
  duration  Int?
  order     Int     @default(0)
  moduleId  String

  // Sandbox config
  sandboxEnabled     Boolean @default(false)
  sandboxLanguage    String?
  sandboxStarterCode String? @db.Text
  sandboxSolution    String? @db.Text
  sandboxTestCode    String? @db.Text

  // Project config
  projectEnabled      Boolean @default(false)
  projectInstructions String? @db.Text
  projectTemplateRepo String?

  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    Progress[]
  tutorChats  TutorChat[]
  projects    Project[]
  notes       LessonNote[]

  @@unique([moduleId, slug])
  @@map("lessons")
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progress")
}

// ==========================================
// GAMIFICATION MODELS
// ==========================================

model UserStats {
  id                   String    @id @default(cuid())
  userId               String    @unique
  totalXp              Int       @default(0)
  level                Int       @default(1)
  currentStreak        Int       @default(0)
  longestStreak        Int       @default(0)
  lastActivityDate     DateTime?
  streakFreezeAvailable Boolean  @default(true)
  streakFreezeUsedAt   DateTime?
  weeklyXp             Int       @default(0)
  weeklyResetAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Achievement {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  icon        String
  category    String
  threshold   Int?
  order       Int     @default(0)

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model XpEvent {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_events")
}

// ==========================================
// LESSON NOTES
// ==========================================

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

// ==========================================
// AI TUTOR
// ==========================================

model TutorChat {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  role      String   // "user" or "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("tutor_chats")
}

// ==========================================
// PROJECTS & PEER REVIEW
// ==========================================

model Project {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  repoUrl     String
  status      String    @default("submitted")
  commitCount Int       @default(0)
  feedback    String?   @db.Text
  reviewedBy  String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviews  PeerReview[]
  comments ProjectComment[]

  @@unique([userId, lessonId])
  @@map("projects")
}

model PeerReview {
  id         String   @id @default(cuid())
  projectId  String
  reviewerId String
  status     String   @default("pending")
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([projectId, reviewerId])
  @@map("peer_reviews")
}

// ==========================================
// RECORDINGS
// ==========================================

model Recording {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  videoUrl    String
  thumbnail   String?
  duration    Int?     // minutes
  category    String   // "live-session", "tutorial", "workshop", "q-and-a"
  courseId     String?
  publishedAt DateTime @default(now())
  order       Int      @default(0)

  course Course? @relation(fields: [courseId], references: [id])

  @@map("recordings")
}

// ==========================================
// COHORTS
// ==========================================

model Cohort {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  ownerId     String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User           @relation("CohortOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CohortMember[]
  courses CohortCourse[]

  @@map("cohorts")
}

model CohortCourse {
  id       String @id @default(cuid())
  cohortId String
  courseId  String

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cohortId, courseId])
  @@map("cohort_courses")
}

model CohortMember {
  id       String   @id @default(cuid())
  cohortId String
  userId   String
  role     String   @default("student")
  joinedAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@map("cohort_members")
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("ProjectComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("project_comments")
}
